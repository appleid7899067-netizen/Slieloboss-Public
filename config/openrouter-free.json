{
  "endpoint": "https://openrouter.ai/api/v1/models",
  "chatEndpoint": "https://openrouter.ai/api/v1/chat/completions",
  "routerModel": "openrouter/free",
  "selection": {
    "textOnly": true,
    "promptPrice": 0,
    "completionPrice": 0,
    "requestPrice": 0,
    "excludeAgenticHarnessOnly": true
  },
  "fallback": {
    "enabled": true,
    "maxAttempts": 8,
    "skipStatusCodes": [400, 401, 403, 404, 408, 409, 429, 500, 502, 503, 504]
  },
  "policy": "Never hard-code a free-model name as authoritative. Refresh /models and filter pricing fields at runtime. Use openrouter/free when a dynamically selected free model is sufficient."
}
