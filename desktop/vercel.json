{
  "buildCommand": "npm run build:renderer && rm -rf vercel-output && cp -R ../dist/renderer vercel-output",
  "outputDirectory": "vercel-output",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
